# Copy to .env.local (never commit .env.local). All values are server-side only.

# Leave empty to run in labeled demo mode (deterministic fixtures, no AI calls).
OPENROUTER_API_KEY=

# "openrouter/free" (free router) or any model ID ending in ":free".
OPENROUTER_MODEL=openrouter/free

# Optional. Must be https.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Any model that is not free is refused unless this is "true". Paid models can cost money.
OPENROUTER_ALLOW_PAID=false

# Optional request timeout in ms (max 60000).
OPENROUTER_TIMEOUT_MS=30000

# Optional: your deployed URL, sent to OpenRouter as HTTP-Referer for app attribution.
APP_URL=

# Abuse limits (per server instance). Defaults: 10 lesson requests/min per client, 30 live-AI calls/min in total.
RATE_LIMIT_PER_MINUTE=10
LIVE_AI_MAX_PER_MINUTE=30
# Only set to true behind a proxy you control that overwrites X-Forwarded-For.
TRUST_PROXY_FORWARDED_FOR=false

# Optional voice narration via a self-hosted Kokoro server (OpenAI-compatible /v1/audio/speech).
# Empty = browser voice only. http is allowed only for localhost.
KOKORO_TTS_URL=
KOKORO_TTS_VOICE=af_heart
KOKORO_TTS_MODEL=kokoro
KOKORO_TTS_API_KEY=
